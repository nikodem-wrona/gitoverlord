{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["dist", "target", "src-tauri", "src/ipc/bindings.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }
    ],
    "max-lines": [
      "error",
      { "max": 200, "skipBlankLines": true, "skipComments": true }
    ],
    "max-lines-per-function": [
      "error",
      { "max": 50, "skipBlankLines": true, "skipComments": true }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/features/*/*"],
            "message": "Import a feature through its index file: @/features/<name>."
          },
          {
            "group": ["@/hud/*", "!@/hud/*.css"],
            "message": "Import HUD components through @/hud."
          },
          {
            "group": ["@/ipc/*"],
            "message": "Import IPC code through @/ipc."
          },
          {
            "group": ["@/actions/*"],
            "message": "Import the action system through @/actions."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ]
}
