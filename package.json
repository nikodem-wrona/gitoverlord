{
  "name": "gitoverlord",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "build:demo": "vite build --mode demo",
    "build:pages": "pnpm build:site && pnpm build:demo",
    "preview:pages": "vite preview --config vite.site.config.ts --base /gitoverlord/ --port 1431 --strictPort",
    "tauri": "tauri",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:install": "bash scripts/release/test-install.sh",
    "bindings": "cargo test -p gitoverlord export_bindings",
    "bench": "cargo test -p git-core --release large_repository -- --ignored --nocapture",
    "icons": "bash scripts/make-icons.sh",
    "check": "pnpm check:ui && pnpm check:rust",
    "check:ui": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@tanstack/react-query": "^5.108.3",
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
